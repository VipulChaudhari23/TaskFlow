generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String 
  reminderEnabled Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // tasks          Task[]
  profiles       Profile[]
  refreshTokens  RefreshToken[]
  accessGranted  TeamAccess[]   @relation("AccessOwner")
  accessReceived TeamAccess[]   @relation("AccessViewer")

  taskComments TaskComment[]
  taskHistory  TaskHistory[]

  @@map("users")
}

model Profile {
  id        String   @id @default(cuid())
  name      String
  avatarColor String  @default("#6366f1")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks  Task[]

  @@map("profiles")
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("PENDING")
  priority    String    @default("MEDIUM")
  progress    Int       @default(0) // ✅ NEW
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // userId String
  // user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  comments TaskComment[]
  history  TaskHistory[]

  @@map("tasks")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model TeamAccess {
  id        String   @id @default(cuid())
  ownerId   String
  viewerId  String
  createdAt DateTime @default(now())

  owner  User @relation("AccessOwner",  fields: [ownerId],  references: [id], onDelete: Cascade)
  viewer User @relation("AccessViewer", fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, viewerId])
  @@map("team_access")
}

model TaskComment {
  id        String   @id @default(cuid())
  message   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("task_comments")
}

model TaskHistory {
  id        String   @id @default(cuid())
  action    String
  changes   String
  createdAt DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("task_history")
}